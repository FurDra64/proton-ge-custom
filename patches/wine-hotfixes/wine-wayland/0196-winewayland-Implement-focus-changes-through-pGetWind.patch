Subject: [PATCH] winewayland: Implement focus changes through
 pGetWindowStateUpdates.

---
dlls/win32u/message.c                   | 10 +++++-----
dlls/winewayland.drv/wayland_keyboard.c | 42 ++++--------------------------------------
dlls/winewayland.drv/waylanddrv.h       | 1 +
dlls/winewayland.drv/waylanddrv_main.c  | 1 +
dlls/winewayland.drv/window.c           | 36 ++++++++++++++++++++++++++++++++++++
 5 files changed, 47 insertions(+), 43 deletions(-)

diff --git a/dlls/win32u/message.c b/dlls/win32u/message.c
index 518bd3cfbb6..6a07c192271 100644
--- a/dlls/win32u/message.c
+++ b/dlls/win32u/message.c
@@ -2243,9 +2243,9 @@ static LRESULT handle_internal_message( HWND hwnd, UINT msg, WPARAM wparam, LPAR
     }
     case WM_WINE_WINDOW_STATE_CHANGED:
     {
-        UINT state_cmd, swp_flags;
-        RECT window_rect;
-        HWND foreground;
+        UINT state_cmd = 0, swp_flags = 0;
+        RECT window_rect = {0};
+        HWND foreground = 0;
 
         if (!user_driver->pGetWindowStateUpdates( hwnd, &state_cmd, &swp_flags, &window_rect, &foreground )) goto unlock;
         window_rect = map_rect_raw_to_virt( window_rect, get_thread_dpi() );
@@ -2256,8 +2256,8 @@ static LRESULT handle_internal_message( HWND hwnd, UINT msg, WPARAM wparam, LPAR
         case SC_RESTORE:
             if (HIWORD(state_cmd) && !foreground) set_foreground_window( hwnd, FALSE, TRUE );
 
-            /* make the win32 window restore to the current host window config */
-            set_window_normal_placement( hwnd, window_rect );
+            /* make the win32 window restore to the current host window config, if present */
+            if (!IsRectEmpty( &window_rect )) set_window_normal_placement( hwnd, window_rect );
 
             /* fallthrough */
         default:

diff --git a/dlls/winewayland.drv/wayland_keyboard.c b/dlls/winewayland.drv/wayland_keyboard.c
