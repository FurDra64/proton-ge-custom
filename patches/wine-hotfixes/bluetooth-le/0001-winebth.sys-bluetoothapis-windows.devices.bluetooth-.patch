+    {
+        LeaveCriticalSection( &impl->cs );
+        return;
+    }
+    for (i = 0; i < count; i++)
+        ITypedEventHandler_BluetoothLEDevice_IInspectable_AddRef(( handlers[i] = impl->status_handlers[i].handler ));
