From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Date: Thu, 6 Aug 2026 19:15:00 -0600
Subject: [PATCH] winepulse: Retarget PipeWire DualSense streams on hotplug

The opt-in Windows Sony audio layout turns controller speaker and haptic
clients into four-channel streams routed through the hidden PipeWire parent.
Unlike the public mono stream, these raw streams were not registered for
hotplug retargeting. Once their controller disappeared, the stream remained
permanently invalid even after Wine published a replacement controller.

Track only live PipeWire-backed streams. When a newly connected Sony endpoint
publishes its hidden parent, close and forget the old PCM, replace its target,
drop samples queued while no controller was present, and open the new node.
If PipeWire has not finished publishing that node, retry the new target from
the normal write path. Never retry the path cleared by a disconnect.

This lets games retain their Windows audio client while swapping between
DualSense, DualSense Edge, and DualShock controllers without preserving any
disconnected physical device.
---
 dlls/winepulse.drv/pulse.c | 159 +++++++++++++++++++++++++++++++-------------------
 1 file changed, 138 insertions(+), 21 deletions(-)

diff --git a/dlls/winepulse.drv/pulse.c b/dlls/winepulse.drv/pulse.c
index 3e2faa5..f32bdac 100644
--- a/dlls/winepulse.drv/pulse.c
+++ b/dlls/winepulse.drv/pulse.c
@@ -118,21 +118,21 @@ struct pulse_stream
     INT64 clock_lastpos, clock_written;
 
     struct list packet_free_head;
-    struct list dualsense_pulse_haptic_entry;
+    struct list dualsense_haptic_entry;
     struct list packet_filled_head;
     struct list period_entry;
     struct list dualsense_mono_entry;
     struct pulse_period *period;
     BOOL dualsense_mono_stream;
     BOOL dualsense_mono_registered;
-    BOOL dualsense_pulse_haptic_registered;
+    BOOL dualsense_haptic_registered;
     BOOL dualsense_mono_audio_active;
 };
 
 static void pulse_write(struct pulse_stream *stream);
 
 static struct list dualsense_mono_streams = LIST_INIT(dualsense_mono_streams);
-static struct list dualsense_pulse_haptic_streams = LIST_INIT(dualsense_pulse_haptic_streams);
+static struct list dualsense_haptic_streams = LIST_INIT(dualsense_haptic_streams);
 
 typedef struct _ACPacket
 {
@@ -812,6 +812,7 @@ again:
 
 static BOOL pulse_refresh_devices(EDataFlow flow);
 static void pulse_retarget_dualsense_mono_streams(const char *preferred);
+static void pulse_retarget_dualsense_haptic_streams(const char *target);
 static BOOL is_dualsense_speaker_sink(const PhysDevice *dev);
 
 /* for winepulse, this function can be called in a separate thread from other functions. */
@@ -837,6 +838,7 @@ static NTSTATUS pulse_get_endpoint_ids(void *args)
     BOOL delta = params->delta;
     BOOL retarget_dualsense_mono = FALSE;
     char *dualsense_mono_target = NULL;
+    char *dualsense_haptic_target = NULL;
 
     TRACE("flow %d, delta %d\n", (int)params->flow, (int)params->delta);
 
@@ -965,6 +967,16 @@ static NTSTATUS pulse_get_endpoint_ids(void *args)
                 free(dualsense_mono_target);
                 dualsense_mono_target = strdup(dev->pulse_name);
             }
+            if (params->flow == eRender && dev->raw_haptic_target)
+            {
+                char *target = strdup(dev->raw_haptic_target);
+
+                if (target)
+                {
+                    free(dualsense_haptic_target);
+                    dualsense_haptic_target = target;
+                }
+            }
             list_remove(&dev->entry);
             list_add_tail(list, &dev->entry);
         }
@@ -1000,6 +1012,16 @@ static NTSTATUS pulse_get_endpoint_ids(void *args)
                 free(dualsense_mono_target);
                 dualsense_mono_target = strdup(dev->pulse_name);
             }
+            if (params->flow == eRender && dev->raw_haptic_target)
+            {
+                char *target = strdup(dev->raw_haptic_target);
+
+                if (target)
+                {
+                    free(dualsense_haptic_target);
+                    dualsense_haptic_target = target;
+                }
+            }
             list_remove(&dev->entry);
             list_add_tail(list, &dev->entry);
         }
@@ -1008,13 +1030,17 @@ static NTSTATUS pulse_get_endpoint_ids(void *args)
 done:
     g_phys_unlock();
 
-    if (retarget_dualsense_mono)
+    if (retarget_dualsense_mono || dualsense_haptic_target)
     {
         pulse_lock();
-        pulse_retarget_dualsense_mono_streams(dualsense_mono_target);
+        if (retarget_dualsense_mono)
+            pulse_retarget_dualsense_mono_streams(dualsense_mono_target);
+        if (dualsense_haptic_target)
+            pulse_retarget_dualsense_haptic_streams(dualsense_haptic_target);
         pulse_unlock();
     }
     free(dualsense_mono_target);
+    free(dualsense_haptic_target);
 
     if (needed > params->size) {
         params->size = needed;
@@ -1089,6 +1115,9 @@ static BOOL pulse_stream_valid(struct pulse_stream *stream)
     if (stream->dualsense_mono_stream || stream->dualsense_mono_registered)
         return TRUE;
 
+    if (!stream->stream && stream->dualsense_haptic_registered)
+        return stream->dataflow == eRender;
+
     if (!stream->stream)
         return stream->dataflow == eRender && (stream->haptic_alsa_path
                 || pulse_stream_dualsense_mono(stream) || pulse_stream_dualsense_pulse_haptic(stream));
@@ -1544,6 +1573,28 @@ static BOOL use_pipewire_dualsense_haptic_target(void)
     return env && env[0] == '1' && !env[1];
 }
 
+static char *make_pipewire_dualsense_haptic_path(const char *target)
+{
+    static const char prefix[] = "pipewire:NODE=";
+    char *path;
+    size_t len;
+
+    if (!target || !target[0])
+        return NULL;
+
+    len = strlen(target) + sizeof(prefix);
+    if ((path = malloc(len)))
+        snprintf(path, len, "%s%s", prefix, target);
+    return path;
+}
+
+static BOOL is_pipewire_dualsense_haptic_path(const char *path)
+{
+    static const char prefix[] = "pipewire:NODE=";
+
+    return path && !strncmp(path, prefix, sizeof(prefix) - 1);
+}
+
 static void apply_windows_sony_audio_format(PhysDevice *dev)
 {
     WAVEFORMATEX *wfx = &dev->fmt.Format;
@@ -3222,6 +3273,53 @@ static void pulse_haptic_drop_held(struct pulse_stream *stream)
     stream->held_bytes = 0;
 }
 
+static HRESULT pulse_retarget_dualsense_haptic_stream(struct pulse_stream *stream, const char *target)
+{
+    char *path;
+    HRESULT hr;
+
+    if (!stream->dualsense_haptic_registered)
+        return S_FALSE;
+    if (!(path = make_pipewire_dualsense_haptic_path(target)))
+        return E_OUTOFMEMORY;
+
+    TRACE("Retargeting Sony controller haptic stream %p from %s to %s.\n",
+            stream, debugstr_a(stream->haptic_alsa_path), debugstr_a(path));
+    if (stream->haptic_pcm)
+    {
+        snd_pcm_drop(stream->haptic_pcm);
+        snd_pcm_close(stream->haptic_pcm);
+        stream->haptic_pcm = NULL;
+    }
+    free(stream->haptic_alsa_path);
+    stream->haptic_alsa_path = path;
+    stream->haptic_reconnect_time = 0;
+    stream->haptic_path_check_time = 0;
+    pulse_haptic_drop_held(stream);
+
+    if (FAILED(hr = pulse_haptic_stream_connect(stream, stream->haptic_alsa_path)))
+    {
+        stream->haptic_reconnect_time = pa_rtclock_now() + 250000;
+        WARN("Failed to retarget Sony controller haptic stream %p to %s: %#x.\n",
+                stream, debugstr_a(stream->haptic_alsa_path), (unsigned int)hr);
+        return hr;
+    }
+
+    stream->just_underran = TRUE;
+    stream->timeline_start_period_time = 0;
+    stream->timeline_start_stream_time = 0;
+    return S_OK;
+}
+
+static void pulse_retarget_dualsense_haptic_streams(const char *target)
+{
+    struct pulse_stream *stream, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE(stream, next, &dualsense_haptic_streams,
+            struct pulse_stream, dualsense_haptic_entry)
+        pulse_retarget_dualsense_haptic_stream(stream, target);
+}
+
 static void pulse_haptic_invalidate(struct pulse_stream *stream, const char *reason)
 {
     TRACE("Invalidating DualSense haptic PCM after %s.\n", reason);
@@ -3261,13 +3312,25 @@ static BOOL pulse_haptic_refresh_path(struct pulse_stream *stream)
     if (stream->haptic_pcm)
     {
         TRACE("Keeping open DualSense haptic PCM across device generation %u -> %u.\n",
                 stream->haptic_hotplug_generation, g_haptic_hotplug_generation);
         stream->haptic_hotplug_generation = g_haptic_hotplug_generation;
         return TRUE;
     }
 
+    if (stream->dualsense_haptic_registered && stream->haptic_alsa_path &&
+            stream->haptic_alsa_path[0])
+    {
+        now = pa_rtclock_now();
+        if (now >= stream->haptic_reconnect_time)
+        {
+            if (SUCCEEDED(pulse_haptic_stream_connect(stream, stream->haptic_alsa_path)))
+                return TRUE;
+            stream->haptic_reconnect_time = now + 250000;
+        }
+    }
+
     stream->haptic_path_check_time = now + DUALSENSE_HAPTIC_REFRESH_USEC;
     stream->haptic_hotplug_generation = g_haptic_hotplug_generation;
     stream->haptic_reconnect_time = 0;
 
     if (!(alsa_path = find_dualsense_haptic_alsa_path()))
@@ -3399,7 +3516,7 @@ static NTSTATUS pulse_create_stream(void *args)
     HRESULT hr;
     char *name, *haptic_target = NULL, *haptic_alsa_path = NULL, *dualsense_speaker = NULL;
     const char *connect_device;
-    BOOL haptic_candidate, dualsense_mono_candidate, dualsense_pulse_haptic_candidate = FALSE;
+    BOOL haptic_candidate, dualsense_mono_candidate, dualsense_haptic_candidate = FALSE;
 
     if (params->share == AUDCLNT_SHAREMODE_EXCLUSIVE) {
         params->result = AUDCLNT_E_EXCLUSIVE_MODE_NOT_ALLOWED;
@@ -3426,7 +3543,7 @@ static NTSTATUS pulse_create_stream(void *args)
     }
 
     stream->dataflow = params->flow;
-    list_init(&stream->dualsense_pulse_haptic_entry);
+    list_init(&stream->dualsense_haptic_entry);
     list_init(&stream->dualsense_mono_entry);
     for (i = 0; i < ARRAY_SIZE(stream->vol); ++i)
         stream->vol[i] = 1.f;
@@ -3455,10 +3572,7 @@ static NTSTATUS pulse_create_stream(void *args)
         stream->map.map[3] = PA_CHANNEL_POSITION_AUX3;
         if (use_pipewire_dualsense_haptic_target() && haptic_target)
         {
-            size_t path_len = strlen(haptic_target) + sizeof("pipewire:NODE=");
-
-            if ((haptic_alsa_path = malloc(path_len)))
-                snprintf(haptic_alsa_path, path_len, "pipewire:NODE=%s", haptic_target);
+            haptic_alsa_path = make_pipewire_dualsense_haptic_path(haptic_target);
             TRACE("Routing DualSense stream from %s through ALSA PipeWire target %s.\n",
                     params->device, haptic_alsa_path ? haptic_alsa_path : haptic_target);
         }
@@ -3536,7 +3650,7 @@ static NTSTATUS pulse_create_stream(void *args)
         else
             hr = E_OUTOFMEMORY;
         if (SUCCEEDED(hr) && !stream->haptic_alsa_path)
-            dualsense_pulse_haptic_candidate = TRUE;
+            dualsense_haptic_candidate = TRUE;
     }
     else
     {
@@ -3591,13 +3705,13 @@ static NTSTATUS pulse_create_stream(void *args)
         }
 
         stream->device = strdup(connect_device);
-        if (dualsense_pulse_haptic_candidate)
+        if (dualsense_haptic_candidate)
         {
             g_phys_lock();
             stream->haptic_hotplug_generation = g_haptic_hotplug_generation;
             g_phys_unlock();
-            list_add_tail(&dualsense_pulse_haptic_streams, &stream->dualsense_pulse_haptic_entry);
-            stream->dualsense_pulse_haptic_registered = TRUE;
+            list_add_tail(&dualsense_haptic_streams, &stream->dualsense_haptic_entry);
+            stream->dualsense_haptic_registered = TRUE;
         }
         if (dualsense_mono_candidate)
         {
@@ -3613,6 +3727,11 @@ static NTSTATUS pulse_create_stream(void *args)
             list_add_tail(&dualsense_mono_streams, &stream->dualsense_mono_entry);
             stream->dualsense_mono_registered = TRUE;
         }
+        if (SUCCEEDED(hr) && is_pipewire_dualsense_haptic_path(stream->haptic_alsa_path))
+        {
+            list_add_tail(&dualsense_haptic_streams, &stream->dualsense_haptic_entry);
+            stream->dualsense_haptic_registered = TRUE;
+        }
     }
 
     *params->channel_count = stream->ss.channels;
@@ -4089,6 +4208,11 @@ static NTSTATUS pulse_release_stream(void *args)
         list_remove(&stream->dualsense_mono_entry);
         stream->dualsense_mono_registered = FALSE;
     }
+    if (stream->dualsense_haptic_registered)
+    {
+        list_remove(&stream->dualsense_haptic_entry);
+        stream->dualsense_haptic_registered = FALSE;
+    }
     pulse_unlock();
 
     if (stream->tmp_buffer) {
@@ -4425,15 +4549,15 @@ static void pulse_reconnect_dualsense_pulse_haptic_streams(struct pulse_period *
     struct pulse_stream *stream, *next;
     unsigned int generation;
 
-    if (list_empty(&dualsense_pulse_haptic_streams))
+    if (list_empty(&dualsense_haptic_streams))
         return;
 
     g_phys_lock();
     generation = g_haptic_hotplug_generation;
     g_phys_unlock();
 
-    LIST_FOR_EACH_ENTRY_SAFE(stream, next, &dualsense_pulse_haptic_streams, struct pulse_stream,
-            dualsense_pulse_haptic_entry)
+    LIST_FOR_EACH_ENTRY_SAFE(stream, next, &dualsense_haptic_streams, struct pulse_stream,
+            dualsense_haptic_entry)
     {
         if (!stream->started)
             continue;
@@ -4464,10 +4588,10 @@ static void pulse_reconnect_dualsense_pulse_haptic_streams(struct pulse_period *
         buffer = stream->local_buffer + (stream->lcl_offs_bytes + stream->held_bytes) % stream->real_bufsize_bytes;
     else
         buffer = stream->tmp_buffer;
-    if (stream->dualsense_pulse_haptic_registered)
+    if (stream->dualsense_haptic_registered)
     {
-        list_remove(&stream->dualsense_pulse_haptic_entry);
-        stream->dualsense_pulse_haptic_registered = FALSE;
+        list_remove(&stream->dualsense_haptic_entry);
+        stream->dualsense_haptic_registered = FALSE;
     }
 
     written_bytes = params->written_frames * pa_frame_size(&stream->ss);
