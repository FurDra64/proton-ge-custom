From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Date: Tue, 21 Jul 2026 13:20:00 -0600
Subject: [PATCH] winepulse: Retarget live Sony controller speaker streams.

Spider-Man Remastered keeps its controller-effect IAudioClient alive across
Sony controller hotplug. The mmdevapi side correctly removes the old physical
endpoint and announces the new one, but the game often keeps writing to the
already-open one-channel effect stream instead of activating the replacement
endpoint, especially after switching between DualSense, DualSense Edge, and
DualShock controllers.

Keep the endpoint/device policy strict: disconnected controller endpoints are
still removed and forgotten. Only retarget already-open Sony controller speaker
streams to the real PulseAudio sink from the latest connected Sony controller
speaker. This avoids keeping stale MMDevice state while preserving the stream
continuity that the game expects for controller speaker effects.

---
 dlls/winepulse.drv/pulse.c | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/dlls/winepulse.drv/pulse.c b/dlls/winepulse.drv/pulse.c
index 2a9f8f1..d8fcae9 100644
--- a/dlls/winepulse.drv/pulse.c
+++ b/dlls/winepulse.drv/pulse.c
@@ -674,6 +674,9 @@ static NTSTATUS pulse_process_detach(void *args)
     if (pulse_ml)
         pa_mainloop_quit(pulse_ml, 0);
 
+    free(g_dualsense_mono_preferred_sink);
+    g_dualsense_mono_preferred_sink = NULL;
+
     pthread_mutex_destroy(&pulse_mutex);
     pthread_mutex_destroy(&g_phys_mutex);
 
@@ -1877,6 +1880,7 @@ static BOOL pulse_refresh_devices(EDataFlow flow)
     pa_mainloop *ml;
     pa_context *ctx;
     pa_operation *o;
+    char *dualsense_mono_target = NULL;
 
     if (!(ml = pa_mainloop_new()))
         return FALSE;
@@ -1962,7 +1966,16 @@ static BOOL pulse_refresh_devices(EDataFlow flow)
         {
             ++g_haptic_hotplug_generation;
             if (is_dualsense_speaker_sink(dev))
+            {
+                char *target = strdup(dev->pulse_name);
+
                 ++g_dualsense_mono_speaker_add_generation;
+                if (target)
+                {
+                    free(dualsense_mono_target);
+                    dualsense_mono_target = target;
+                }
+            }
         }
         list_remove(&dev->entry);
         list_add_tail(added, &dev->entry);
@@ -1970,6 +1983,14 @@ static BOOL pulse_refresh_devices(EDataFlow flow)
 
     g_phys_unlock();
 
+    if (dualsense_mono_target)
+    {
+        pulse_lock();
+        pulse_retarget_dualsense_mono_streams(dualsense_mono_target);
+        pulse_unlock();
+        free(dualsense_mono_target);
+    }
+
     pa_context_unref(ctx);
     pa_mainloop_free(ml);
 
@@ -1980,6 +2001,7 @@ static BOOL pulse_refresh_devices(EDataFlow flow)
     return TRUE;
 
 fail:
+    free(dualsense_mono_target);
     pa_context_unref(ctx);
     pa_mainloop_free(ml);
     LIST_FOR_EACH_ENTRY_SAFE(dev, next, &current, PhysDevice, entry)
@@ -3914,6 +3936,11 @@ static NTSTATUS pulse_release_stream(void *args)
         snd_pcm_drop(stream->haptic_pcm);
         snd_pcm_close(stream->haptic_pcm);
     }
+    if (stream->dualsense_mono_registered)
+    {
+        list_remove(&stream->dualsense_mono_entry);
+        stream->dualsense_mono_registered = FALSE;
+    }
     pulse_unlock();
 
     if (stream->tmp_buffer) {
