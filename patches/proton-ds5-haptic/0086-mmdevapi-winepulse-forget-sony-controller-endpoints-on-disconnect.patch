From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Date: Mon, 13 Jul 2026 12:00:00 -0600
Subject: [PATCH] mmdevapi,winepulse: Forget Sony controller endpoints on disconnect.

Do not keep disconnected DualSense, DualSense Edge, or DualShock mono speaker endpoints alive for later retargeting.
Spider-Man Remastered can crash when stale controller MMDevice/Pulse state survives a model swap and the game binds its controller-effect stream to an old endpoint.
Treat every Sony controller connection as a fresh device: avoid persisted registry GUIDs for Sony controller backend names, delete endpoint state on removal, notify clients that the endpoint was removed, and stop retargeting existing mono streams to later hotplugged speakers.
This keeps the prefix and Wine process from carrying controller identity across DS, DS Edge, and DualShock disconnect/reconnect cycles.

---
 dlls/mmdevapi/devenum.c    | 208 +++++++++++++++++++++++++--------------------
 dlls/winepulse.drv/pulse.c | 170 +-----------------------------------
 2 files changed, 121 insertions(+), 257 deletions(-)

diff --git a/dlls/mmdevapi/devenum.c b/dlls/mmdevapi/devenum.c
index 2e8b51ef2249ffaf6f4205c17161d3dd24b5a199..c46630666556c885a13294e505c6bc7aadb896ce 100644
--- a/dlls/mmdevapi/devenum.c
+++ b/dlls/mmdevapi/devenum.c
@@ -107,6 +107,13 @@ static BOOL is_dualsense_endpoint_name( const WCHAR *name )
             wcsstr( name, L"Wireless Controller" ));
 }
 
+static BOOL is_dualsense_backend_name( const char *name )
+{
+    return name && (strstr( name, "DualSense" ) || strstr( name, "DualShock" ) ||
+            strstr( name, "Wireless Controller" ) || strstr( name, "Wireless_Controller" ) ||
+            strstr( name, "Sony_Interactive_Entertainment" ));
+}
+
 static BOOL device_is_published(const GUID *devguid, EDataFlow flow)
 {
     MMDevice *device;
@@ -225,6 +232,29 @@ static struct device *find_device_in_cache( const GUID *guid )
     return NULL;
 }
 
+static struct device *find_device_name_in_cache( const char *name, EDataFlow flow )
+{
+    struct device *dev;
+
+    LIST_FOR_EACH_ENTRY( dev, &devices_cache, struct device, entry )
+        if (dev->flow == flow && !strcmp( dev->name, name )) return dev;
+    return NULL;
+}
+
+static void remove_device_from_cache( const GUID *guid )
+{
+    struct device *dev, *next;
+
+    EnterCriticalSection( &devices_cache_cs );
+    LIST_FOR_EACH_ENTRY_SAFE( dev, next, &devices_cache, struct device, entry )
+    {
+        if (!IsEqualGUID( guid, &dev->guid )) continue;
+        list_remove( &dev->entry );
+        free( dev );
+    }
+    LeaveCriticalSection( &devices_cache_cs );
+}
+
 BOOL get_device_name_from_guid( const GUID *guid, char **name, EDataFlow *flow )
 {
     struct device *dev;
@@ -243,7 +273,7 @@ BOOL get_device_name_from_guid( const GUID *guid, char **name, EDataFlow *flow )
     }
 
     swprintf( key_name, ARRAY_SIZE(key_name), L"Software\\Wine\\Drivers\\%s\\devices", drvs.module_name );
-    if (RegOpenKeyExW( HKEY_CURRENT_USER, key_name, 0, KEY_READ | KEY_WOW64_64KEY, &key )) {
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, key_name, 0, KEY_READ | KEY_WRITE | KEY_WOW64_64KEY, &key )) {
         LeaveCriticalSection( &devices_cache_cs );
         return FALSE;
     }
@@ -267,16 +297,28 @@ BOOL get_device_name_from_guid( const GUID *guid, char **name, EDataFlow *flow )
         else if (key_name[0] == '1') *flow = eCapture;
         else continue;
 
-        RegCloseKey( key );
         TRACE( "Found matching device key %s for %s\n", wine_dbgstr_w(key_name), debugstr_guid(guid) );
         size = WideCharToMultiByte( CP_UNIXCP, 0, key_name + 2, -1, NULL, 0, NULL, NULL );
         if (!(*name = malloc( size ))) {
+            RegCloseKey( key );
             LeaveCriticalSection( &devices_cache_cs );
             return FALSE;
         }
         WideCharToMultiByte( CP_UNIXCP, 0, key_name + 2, -1, *name, size, NULL, NULL );
+        if (is_dualsense_backend_name( *name ))
+        {
+            TRACE( "Dropping persisted Sony controller device key %s for %s\n",
+                   debugstr_a(*name), debugstr_guid(guid) );
+            RegDeleteTreeW( key, key_name );
+            RegCloseKey( key );
+            free( *name );
+            *name = NULL;
+            LeaveCriticalSection( &devices_cache_cs );
+            return FALSE;
+        }
         add_device_to_cache( guid, *name, *flow );
 
+        RegCloseKey( key );
         LeaveCriticalSection( &devices_cache_cs );
         return TRUE;
     }
@@ -287,7 +329,7 @@ BOOL get_device_name_from_guid( const GUID *guid, char **name, EDataFlow *flow )
     return FALSE;
 }
 
-static void get_device_guid( EDataFlow flow, const char *dev_name, GUID *guid )
+static void get_device_guid( EDataFlow flow, const char *dev_name, BOOL create, GUID *guid )
 {
     WCHAR name[512];
     DWORD type, size = sizeof(*guid);
@@ -295,6 +337,24 @@ static void get_device_guid( EDataFlow flow, const char *dev_name, GUID *guid )
     LSTATUS status;
     int len;
 
+    if (is_dualsense_backend_name( dev_name ))
+    {
+        struct device *dev;
+
+        EnterCriticalSection( &devices_cache_cs );
+        if ((dev = find_device_name_in_cache( dev_name, flow )))
+            *guid = dev->guid;
+        else if (create)
+        {
+            CoCreateGuid( guid );
+            add_device_to_cache( guid, dev_name, flow );
+        }
+        else
+            memset( guid, 0, sizeof(*guid) );
+        LeaveCriticalSection( &devices_cache_cs );
+        return;
+    }
+
     len = swprintf( name, ARRAY_SIZE(name), L"Software\\Wine\\Drivers\\%s\\devices\\%u,",
                     drvs.module_name, flow == eCapture );
     MultiByteToWideChar( CP_UNIXCP, 0, dev_name, -1, name + len, ARRAY_SIZE(name) - len );
@@ -808,19 +868,32 @@ static void notify_endpoint_added_state(EDataFlow flow, const GUID *id, DWORD st
     LeaveCriticalSection(&g_notif_lock);
 }
 
-static void set_device_state(MMDevice *device, DWORD state)
+static void notify_endpoint_removed(EDataFlow flow, const GUID *id)
 {
-    HKEY key, root = device->flow == eRender ? key_render : key_capture;
-    WCHAR guidstr[39];
+    struct NotificationClientWrapper *wrapper;
+    WCHAR devid[56];
 
-    device->state = state;
-    StringFromGUID2(&device->devguid, guidstr, ARRAY_SIZE(guidstr));
-    if (RegCreateKeyExW(root, guidstr, 0, NULL, 0, KEY_WRITE | KEY_READ | KEY_WOW64_64KEY,
-            NULL, &key, NULL) == ERROR_SUCCESS)
+    swprintf(devid, 56, devid_formatW,
+            flow, id->Data1, id->Data2, id->Data3,
+            id->Data4[0], id->Data4[1], id->Data4[2], id->Data4[3],
+            id->Data4[4], id->Data4[5], id->Data4[6], id->Data4[7]);
+
+    EnterCriticalSection(&g_notif_lock);
+    LIST_FOR_EACH_ENTRY(wrapper, &g_notif_clients, struct NotificationClientWrapper, entry)
     {
-        RegSetValueExW(key, L"DeviceState", 0, REG_DWORD, (const BYTE *)&device->state, sizeof(DWORD));
-        RegCloseKey(key);
+        IMMNotificationClient_OnDeviceStateChanged(wrapper->client, devid, DEVICE_STATE_NOTPRESENT);
+        IMMNotificationClient_OnDeviceRemoved(wrapper->client, devid);
     }
+    LeaveCriticalSection(&g_notif_lock);
+}
+
+static void delete_device_state_key(MMDevice *device)
+{
+    HKEY root = device->flow == eRender ? key_render : key_capture;
+    WCHAR guidstr[39];
+
+    StringFromGUID2(&device->devguid, guidstr, ARRAY_SIZE(guidstr));
+    RegDeleteTreeW(root, guidstr);
 }
 
 static BOOL add_endpoint_notification(struct endpoint_notification **notifications,
@@ -850,51 +923,22 @@ static BOOL add_endpoint_notification(struct endpoint_notification **notificatio
     return TRUE;
 }
 
-static void resignal_visible_dualsense_mono_endpoints(enum dualsense_mono_model model, BOOL allow_hidden)
+static void resignal_visible_dualsense_mono_endpoints(enum dualsense_mono_model model)
 {
     struct endpoint_notification *notifications = NULL;
     unsigned int count = 0, capacity = 0, i;
-    MMDevice *device, *hidden = NULL;
+    MMDevice *device;
 
     EnterCriticalSection(&device_list_cs);
-    if (allow_hidden && model != DUALSENSE_MONO_MODEL_UNKNOWN)
-    {
-        LIST_FOR_EACH_ENTRY(device, &device_list, MMDevice, entry)
-        {
-            if (!is_dualsense_mono_endpoint(device) || !device->hide_from_collection)
-                continue;
-            if (dualsense_mono_endpoint_model(device) != model)
-                continue;
-
-            if (!hidden || device->dualsense_mono_activation_serial > hidden->dualsense_mono_activation_serial)
-                hidden = device;
-        }
-    }
-
-    if (hidden)
-    {
-        if (!(hidden->state & DEVICE_STATE_ACTIVE))
-        {
-            TRACE("Reactivating hidden DualSense mono endpoint %s after replacement speaker hotplug.\n",
-                    debugstr_guid(&hidden->devguid));
-            set_device_state(hidden, DEVICE_STATE_ACTIVE);
-        }
-
-        hidden->hide_from_collection = FALSE;
-        add_endpoint_notification(&notifications, &count, &capacity, hidden);
-    }
-    else
+    LIST_FOR_EACH_ENTRY(device, &device_list, MMDevice, entry)
     {
-        LIST_FOR_EACH_ENTRY(device, &device_list, MMDevice, entry)
-        {
-            if (!is_dualsense_mono_endpoint(device) || should_hide_from_endpoint_collection(device))
-                continue;
-            if (model != DUALSENSE_MONO_MODEL_UNKNOWN && dualsense_mono_endpoint_model(device) != model)
-                continue;
+        if (!is_dualsense_mono_endpoint(device) || should_hide_from_endpoint_collection(device))
+            continue;
+        if (model != DUALSENSE_MONO_MODEL_UNKNOWN && dualsense_mono_endpoint_model(device) != model)
+            continue;
 
-            if (!add_endpoint_notification(&notifications, &count, &capacity, device))
-                break;
-        }
+        if (!add_endpoint_notification(&notifications, &count, &capacity, device))
+            break;
     }
     LeaveCriticalSection(&device_list_cs);
 
@@ -909,31 +953,6 @@ static void resignal_visible_dualsense_mono_endpoints(enum dualsense_mono_model
     free(notifications);
 }
 
-static BOOL has_hidden_dualsense_mono_endpoint(enum dualsense_mono_model model)
-{
-    MMDevice *device;
-    BOOL found = FALSE;
-
-    if (model == DUALSENSE_MONO_MODEL_UNKNOWN)
-        return FALSE;
-
-    EnterCriticalSection(&device_list_cs);
-    LIST_FOR_EACH_ENTRY(device, &device_list, MMDevice, entry)
-    {
-        if (is_dualsense_mono_endpoint(device) && device->hide_from_collection
-                && (device->state & DEVICE_STATE_ACTIVE)
-                && device->dualsense_mono_activation_serial
-                && dualsense_mono_endpoint_model(device) == model)
-        {
-            found = TRUE;
-            break;
-        }
-    }
-    LeaveCriticalSection(&device_list_cs);
-
-    return found;
-}
-
 static void remove_dualsense_media_devices(void)
 {
     static const GUID MEDIA_ClassGUID = { 0x4d36e96c, 0xe325, 0x11ce, { 0xbf, 0xc1, 0x08, 0x00, 0x2b, 0xe1, 0x03, 0x18 } };
@@ -1542,7 +1561,6 @@ static HRESULT set_format(MMDevice *dev)
 static LONG dualsense_mono_render_add_pending;
 static LONG dualsense_mono_activation_serial;
 static enum dualsense_mono_model dualsense_mono_render_add_model;
-static enum dualsense_mono_model dualsense_mono_render_removed_model;
 
 static void add_endpoints_from_params(struct get_endpoint_ids_params *params)
 {
@@ -1553,7 +1571,7 @@ static void add_endpoints_from_params(struct get_endpoint_ids_params *params)
         GUID guid;
         const WCHAR *name = (WCHAR *)((char *)params->endpoints + params->endpoints[i].name);
         const char *dev_name = (char *)params->endpoints + params->endpoints[i].device;
-        get_device_guid(params->flow, dev_name, &guid);
+        get_device_guid(params->flow, dev_name, TRUE, &guid);
         device = MMDevice_Create(name, &guid, params->flow, DEVICE_STATE_ACTIVE, params->default_idx == i);
         if (device && params->flow == eRender && is_dualsense_mono_endpoint(device))
         {
@@ -1625,8 +1643,9 @@ static DWORD WINAPI update_thread_proc(void *user)
             GUID guid;
             MMDevice *dev;
             UINT i_removed = params.num + i;
+            const WCHAR *name = (WCHAR *)((char *)params.endpoints + params.endpoints[i_removed].name);
             const char *dev_name = (char *)params.endpoints + params.endpoints[i_removed].device;
-            get_device_guid( params.flow, dev_name, &guid );
+            get_device_guid( params.flow, dev_name, FALSE, &guid );
 
             EnterCriticalSection(&device_list_cs);
             LIST_FOR_EACH_ENTRY(dev, &device_list, MMDevice, entry) {
@@ -1634,17 +1653,32 @@ static DWORD WINAPI update_thread_proc(void *user)
                 HKEY key, root;
                 if (dev->flow != params.flow)
                     continue;
-                if (IsEqualGUID(&dev->devguid, &guid)) {
+                if (IsEqualGUID(&dev->devguid, &guid) ||
+                        (dev->drv_id && is_dualsense_mono_endpoint_name(name) && !wcscmp(dev->drv_id, name))) {
                     struct NotificationClientWrapper *wrapper;
                     const GUID *id = &dev->devguid;
                     BOOL dualsense_mono_endpoint = is_dualsense_mono_endpoint(dev);
+                    BOOL sony_controller_endpoint = is_dualsense_endpoint_name(dev->drv_id);
                     WCHAR devid[56];
 
-                    if (dualsense_mono_endpoint && dev->hide_from_collection)
+                    if (sony_controller_endpoint)
                     {
-                        dualsense_mono_render_removed_model = dualsense_mono_endpoint_model(dev);
-                        TRACE("Keeping activated disconnected DualSense mono endpoint %s active for stream retargeting.\n",
-                                debugstr_guid(&dev->devguid));
+                        TRACE("Removing disconnected Sony controller endpoint %s from active device list.\n",
+                                debugstr_guid(id));
+                        if (dualsense_mono_endpoint)
+                        {
+                            remove_dualsense_audioendpoint_devices();
+                            remove_dualsense_media_devices();
+                        }
+                        notify_endpoint_removed(dev->flow, id);
+                        remove_device_from_cache(id);
+                        delete_device_state_key(dev);
+                        dev->removed = TRUE;
+                        dev->state = DEVICE_STATE_NOTPRESENT;
+                        list_remove(&dev->entry);
+                        list_init(&dev->entry);
+                        if (!dev->ref)
+                            MMDevice_Destroy(dev);
                         break;
                     }
 
@@ -1685,14 +1719,9 @@ static DWORD WINAPI update_thread_proc(void *user)
             if (InterlockedExchange(&dualsense_mono_render_add_pending, 0))
             {
                 enum dualsense_mono_model model = dualsense_mono_render_add_model;
-                enum dualsense_mono_model removed_model = dualsense_mono_render_removed_model;
-                BOOL allow_hidden = model != DUALSENSE_MONO_MODEL_UNKNOWN &&
-                        removed_model != DUALSENSE_MONO_MODEL_UNKNOWN && model == removed_model;
 
                 dualsense_mono_render_add_model = DUALSENSE_MONO_MODEL_UNKNOWN;
-                dualsense_mono_render_removed_model = DUALSENSE_MONO_MODEL_UNKNOWN;
-                resignal_visible_dualsense_mono_endpoints(model,
-                        allow_hidden || has_hidden_dualsense_mono_endpoint(model));
+                resignal_visible_dualsense_mono_endpoints(model);
             }
             InterlockedExchange(&render_update_in_progress, 0);
         }
@@ -1705,7 +1734,6 @@ end:
     InterlockedExchange(&render_update_in_progress, 0);
     InterlockedExchange(&dualsense_mono_render_add_pending, 0);
     dualsense_mono_render_add_model = DUALSENSE_MONO_MODEL_UNKNOWN;
-    dualsense_mono_render_removed_model = DUALSENSE_MONO_MODEL_UNKNOWN;
     free(params.endpoints);
     return 0;
 }
