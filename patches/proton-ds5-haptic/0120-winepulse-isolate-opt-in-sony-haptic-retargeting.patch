From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Date: Sat, 8 Aug 2026 20:30:00 -0600
Subject: [PATCH] winepulse: Isolate opt-in Sony haptic retargeting

The PipeWire non-event path added live four-channel stream retention and
retargeting for games which require Windows-style Sony audio devices. Those
lifetime changes were also active without the option, altering the previously
working Spider-Man controller-speaker hotplug path.

Only retain, reconnect, and retarget raw Sony haptic streams when
PROTON_DUALSENSE_HAPTICS_PREFER_NON_EVENT=1. Without it, preserve the earlier
behavior: a raw stream belongs to its original physical connection and is
invalidated when that device generation disappears. Mono controller-speaker
stream hotplugging remains enabled in both modes.
---
 dlls/winepulse.drv/pulse.c | 24 ++++++++++++++++++------
 1 file changed, 18 insertions(+), 6 deletions(-)

diff --git a/dlls/winepulse.drv/pulse.c b/dlls/winepulse.drv/pulse.c
--- a/dlls/winepulse.drv/pulse.c
+++ b/dlls/winepulse.drv/pulse.c
@@ -812,6 +812,7 @@ again:
 
 static BOOL pulse_refresh_devices(EDataFlow flow);
 static void pulse_retarget_dualsense_mono_streams(const char *preferred);
+static BOOL use_pipewire_dualsense_haptic_target(void);
 static void pulse_retarget_dualsense_haptic_streams(const char *target);
 static void pulse_retarget_dualsense_haptic_streams_to_alsa(const char *path);
 static char *find_dualsense_haptic_alsa_path(void);
@@ -839,6 +840,7 @@ static NTSTATUS pulse_get_endpoint_ids(void *args)
     PhysDevice *dev, *dev_next;
     BOOL delta = params->delta;
     BOOL find_dualsense_haptic_alsa = FALSE;
+    BOOL retarget_haptic = use_pipewire_dualsense_haptic_target();
     BOOL retarget_dualsense_mono = FALSE;
     char *dualsense_mono_target = NULL;
     char *dualsense_haptic_target = NULL;
@@ -970,10 +972,10 @@ static NTSTATUS pulse_get_endpoint_ids(void *args)
                 retarget_dualsense_mono = TRUE;
                 free(dualsense_mono_target);
                 dualsense_mono_target = strdup(dev->pulse_name);
-                if (!dev->raw_haptic_target)
+                if (retarget_haptic && !dev->raw_haptic_target)
                     find_dualsense_haptic_alsa = TRUE;
             }
-            if (params->flow == eRender && dev->raw_haptic_target)
+            if (retarget_haptic && params->flow == eRender && dev->raw_haptic_target)
             {
                 char *target = strdup(dev->raw_haptic_target);
 
@@ -1017,10 +1019,10 @@ static NTSTATUS pulse_get_endpoint_ids(void *args)
                 retarget_dualsense_mono = TRUE;
                 free(dualsense_mono_target);
                 dualsense_mono_target = strdup(dev->pulse_name);
-                if (!dev->raw_haptic_target)
+                if (retarget_haptic && !dev->raw_haptic_target)
                     find_dualsense_haptic_alsa = TRUE;
             }
-            if (params->flow == eRender && dev->raw_haptic_target)
+            if (retarget_haptic && params->flow == eRender && dev->raw_haptic_target)
             {
                 char *target = strdup(dev->raw_haptic_target);
 
@@ -1132,7 +1134,8 @@ static BOOL pulse_stream_valid(struct pulse_stream *stream)
     if (stream->dualsense_mono_stream || stream->dualsense_mono_registered)
         return TRUE;
 
-    if (!stream->stream && stream->dualsense_haptic_registered)
+    if (use_pipewire_dualsense_haptic_target() && !stream->stream &&
+            stream->dualsense_haptic_registered)
         return stream->dataflow == eRender;
 
     if (!stream->stream)
@@ -3374,6 +3377,14 @@ static BOOL pulse_haptic_refresh_path(struct pulse_stream *stream)
     char *alsa_path;
     BOOL changed;
 
+    if (!use_pipewire_dualsense_haptic_target())
+    {
+        if (stream->haptic_pcm && stream->haptic_hotplug_generation == g_haptic_hotplug_generation)
+            return TRUE;
+        TRACE("DualSense haptic stream no longer matches the current device generation.\n");
+        return FALSE;
+    }
+
     if (stream->haptic_path_check_time && now < stream->haptic_path_check_time)
         return stream->haptic_pcm != NULL;
 
@@ -3758,7 +3769,8 @@ static NTSTATUS pulse_create_stream(void *args)
             list_add_tail(&dualsense_mono_streams, &stream->dualsense_mono_entry);
             stream->dualsense_mono_registered = TRUE;
         }
-        if (SUCCEEDED(hr) && haptic_candidate)
+        if (SUCCEEDED(hr) && haptic_candidate &&
+                use_pipewire_dualsense_haptic_target())
         {
             list_add_tail(&dualsense_haptic_streams, &stream->dualsense_haptic_entry);
             stream->dualsense_haptic_registered = TRUE;
-- 
